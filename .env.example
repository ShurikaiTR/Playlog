# Üretim sırları (compose.yaml bunları okur). Kopyala: cp .env.example .env
# Yerel geliştirme ayarları ayrı dosyalarda: web/.env.example ve api/.env.example
POSTGRES_PASSWORD=
# openssl rand -base64 48
CODE_SECRET=
RESEND_API_KEY=
MAIL_FROM=Playthru <noreply@alanadi>

# Sitenin dışarıdan adresi (Google/Discord girişi için zorunlu)
PUBLIC_URL=https://playthru.app
# Google: console.cloud.google.com > Google Auth Platform > Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord: discord.com/developers/applications > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Apple: developer.apple.com > Certificates, Identifiers & Profiles
#   APPLE_CLIENT_ID   = Services ID (örn. app.playthru.web), Return URL: https://playthru.app/auth/apple/callback
#   APPLE_TEAM_ID     = hesabın Team ID'si (10 karakter)
#   APPLE_KEY_ID      = "Sign in with Apple" anahtarının Key ID'si
#   APPLE_PRIVATE_KEY = indirilen .p8 dosyasının içeriği; tek satırda satır sonları \n olarak yazılabilir
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# İlk admin: önce bu e-postayla hesap aç (e-posta doğrulanmış olmalı), sonra api'yi yeniden başlat.
# Yalnızca hiç admin yokken çalışır; bir admin oluştuktan sonra etkisi yoktur.
ADMIN_EMAIL=

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile, Managed widget). Üçü de boşsa bot doğrulaması kapalıdır.
#   TURNSTILE_SITE_KEY   = herkese açık site anahtarı (web)
#   TURNSTILE_SECRET     = gizli anahtar, yalnızca api; depoya yazma
#   TURNSTILE_HOSTNAMES  = izinli alan adları, virgülle (örn. playthru.app,www.playthru.app)
# Yerel geliştirme için Cloudflare'in test anahtarları:
#   site anahtarı: 1x00000000000000000000AA (her zaman geçer; 2x00000000000000000000AB her zaman reddeder)
#   gizli anahtar: 1x0000000000000000000000000000000AA (her zaman geçer; 2x0000000000000000000000000000000AA reddeder)
#   test anahtarlarıyla alan adı denetimi anlamsızdır, TURNSTILE_HOSTNAMES'i boş bırak.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
