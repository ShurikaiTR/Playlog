# Yerel geliştirme (npm run dev). Kopyala: cp .env.example .env
# SvelteKit sunucusunun Rust API adresi. Üretimde compose bunu http://api:8080 olarak verir.
API_URL=http://localhost:8080
# Cloudflare Turnstile site anahtarı (herkese açık). Boşsa widget gösterilmez.
# Yerel geliştirme için test anahtarı: 1x00000000000000000000AA (her zaman geçer)
TURNSTILE_SITE_KEY=
