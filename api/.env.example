DATABASE_URL=postgres://playthru:playthru@127.0.0.1:5433/playthru
BIND_ADDR=127.0.0.1:8080
# DB_MAX_CONNECTIONS=10
# RUST_LOG=info,tower_http=debug
# Kod HMAC sırrı (en az 32 karakter): openssl rand -base64 48
CODE_SECRET=gelistirme-icin-en-az-32-karakterlik-sir-degistir
# RESEND_API_KEY yoksa e-postalar günlüğe yazılır (yalnızca geliştirme)
# RESEND_API_KEY=
# MAIL_FROM=Playthru <noreply@alanadi>
# Google/Discord girişi (isteğe bağlı; yoksa o sağlayıcı kapalı)
# PUBLIC_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Apple: developer.apple.com > Certificates, Identifiers & Profiles
#   APPLE_CLIENT_ID   = Services ID (örn. app.playthru.web), Return URL: https://playthru.app/auth/apple/callback
#   APPLE_TEAM_ID     = hesabın Team ID'si (10 karakter)
#   APPLE_KEY_ID      = "Sign in with Apple" anahtarının Key ID'si
#   APPLE_PRIVATE_KEY = indirilen .p8 dosyasının içeriği; tek satırda satır sonları \n olarak yazılabilir
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# İlk admin: önce bu e-postayla hesap aç (e-posta doğrulanmış olmalı), sonra API'yi yeniden başlat.
# Yalnızca hiç admin yokken çalışır; bir admin oluştuktan sonra etkisi yoktur.
# ADMIN_EMAIL=
